generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CollectionKind {
  ALBUM
  TIMELINE
  EDUCATIONAL
}

enum DatePrecision {
  UNKNOWN
  EXACT
  MONTH
  YEAR
  RANGE
  APPROXIMATE
}

enum AssetKind {
  PHOTO
  AUDIO
  THUMBNAIL
}

enum PageElementKind {
  PHOTO
  AUDIO
  TEXT
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  firstName    String       @map("first_name") @db.VarChar(100)
  lastName     String       @map("last_name") @db.VarChar(100)
  birthDate    DateTime     @map("birth_date") @db.Date
  country      String       @db.VarChar(120)
  email        String       @unique @db.VarChar(254)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  collections  Collection[]
  events       Event[]
  people       Person[]

  @@map("users")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  title       String           @db.VarChar(160)
  kind        CollectionKind
  description String?          @db.Text
  ownerId     String?          @map("owner_id") @db.Uuid
  coverAssetId String?         @unique @map("cover_asset_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  coverAsset  MediaAsset?      @relation("CollectionCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  items       CollectionItem[]
  pages       Page[]

  @@index([kind])
  @@index([ownerId, updatedAt])
  @@map("collections")
}

model Event {
  id                String           @id @default(uuid()) @db.Uuid
  title             String           @db.VarChar(200)
  description       String?          @db.Text
  dateStart         DateTime?        @map("date_start") @db.Date
  dateEnd           DateTime?        @map("date_end") @db.Date
  datePrecision     DatePrecision    @default(UNKNOWN) @map("date_precision")
  locationName      String?          @map("location_name") @db.VarChar(200)
  locationLatitude  Float?           @map("location_latitude")
  locationLongitude Float?           @map("location_longitude")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerId           String?          @map("owner_id") @db.Uuid
  owner             User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collectionItems   CollectionItem[]
  photos            EventPhoto[]
  narrations        Narration[]
  people            EventPerson[]
  categories        EventCategory[]
  tags              EventTag[]

  @@index([dateStart])
  @@index([title])
  @@map("events")
}

model CollectionItem {
  collectionId String     @map("collection_id") @db.Uuid
  eventId      String     @map("event_id") @db.Uuid
  position     Int
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([collectionId, eventId])
  @@unique([collectionId, position])
  @@index([eventId])
  @@map("collection_items")
}

model MediaAsset {
  id                     String       @id @default(uuid()) @db.Uuid
  kind                   AssetKind
  storageKey             String       @unique @map("storage_key") @db.VarChar(500)
  thumbnailStorageKey    String?      @unique @map("thumbnail_storage_key") @db.VarChar(500)
  originalName           String       @map("original_name") @db.VarChar(255)
  mimeType               String       @map("mime_type") @db.VarChar(120)
  sizeBytes              BigInt       @map("size_bytes")
  sha256                 String       @db.Char(64)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  eventPhotos            EventPhoto[]
  narrationAudio         Narration[]  @relation("NarrationAudio")
  narrationPhoto         Narration[]  @relation("NarrationRelatedPhoto")
  pageElements           PageElement[]
  collectionCover        Collection?  @relation("CollectionCover")

  @@index([kind])
  @@map("media_assets")
}

model EventPhoto {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  assetId   String     @map("asset_id") @db.Uuid
  position  Int
  caption   String?    @db.VarChar(300)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([eventId, assetId])
  @@unique([eventId, position])
  @@map("event_photos")
}

model Person {
  id         String        @id @default(uuid()) @db.Uuid
  name       String        @db.VarChar(160)
  notes      String?       @db.Text
  ownerId    String?       @map("owner_id") @db.Uuid
  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  eventLinks EventPerson[]
  narrations Narration[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("people")
}

model EventPerson {
  eventId  String  @map("event_id") @db.Uuid
  personId String  @map("person_id") @db.Uuid
  role     String? @db.VarChar(100)
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
  @@map("event_people")
}

model Narration {
  id                  String     @id @default(uuid()) @db.Uuid
  eventId             String     @map("event_id") @db.Uuid
  audioAssetId        String     @map("audio_asset_id") @db.Uuid
  speakerId           String?    @map("speaker_id") @db.Uuid
  relatedPhotoAssetId String?    @map("related_photo_asset_id") @db.Uuid
  title               String     @db.VarChar(200)
  transcript          String?    @db.Text
  durationSeconds     Int?       @map("duration_seconds")
  position            Int
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  event               Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audioAsset          MediaAsset @relation("NarrationAudio", fields: [audioAssetId], references: [id], onDelete: Restrict)
  speaker             Person?    @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  relatedPhotoAsset   MediaAsset? @relation("NarrationRelatedPhoto", fields: [relatedPhotoAssetId], references: [id], onDelete: SetNull)
  pageElements        PageElement[]

  @@unique([eventId, position])
  @@index([speakerId])
  @@map("narrations")
}

model Category {
  id     String          @id @default(uuid()) @db.Uuid
  name   String          @unique @db.VarChar(100)
  events EventCategory[]

  @@map("categories")
}

model EventCategory {
  eventId    String   @map("event_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([eventId, categoryId])
  @@map("event_categories")
}

model Tag {
  id     String     @id @default(uuid()) @db.Uuid
  name   String     @unique @db.VarChar(80)
  events EventTag[]

  @@map("tags")
}

model EventTag {
  eventId String @map("event_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@map("event_tags")
}

model Page {
  id           String        @id @default(uuid()) @db.Uuid
  collectionId String        @map("collection_id") @db.Uuid
  pageNumber   Int           @map("page_number")
  width        Int
  height       Int
  background   String?       @db.VarChar(30)
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  elements     PageElement[]

  @@unique([collectionId, pageNumber])
  @@map("pages")
}

model PageElement {
  id          String          @id @default(uuid()) @db.Uuid
  pageId      String          @map("page_id") @db.Uuid
  kind        PageElementKind
  assetId     String?         @map("asset_id") @db.Uuid
  narrationId String?         @map("narration_id") @db.Uuid
  x           Float           @default(0)
  y           Float           @default(0)
  width       Float
  height      Float
  zIndex      Int             @default(0) @map("z_index")
  rotation    Float           @default(0)
  props       Json            @default("{}")
  page        Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  asset       MediaAsset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  narration   Narration?      @relation(fields: [narrationId], references: [id], onDelete: SetNull)

  @@index([pageId, zIndex])
  @@map("page_elements")
}
