# PostgreSQL local (Docker Compose)
POSTGRES_DB=memoria_viva
POSTGRES_USER=memoria
POSTGRES_PASSWORD=memoria_local_dev
POSTGRES_PORT=5432

# NestJS API (se ejecuta en el host durante el desarrollo)
DATABASE_URL=postgresql://memoria:memoria_local_dev@localhost:5432/memoria_viva?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MEDIA_ROOT=../../var/uploads

# Angular
